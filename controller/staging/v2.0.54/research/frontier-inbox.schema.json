{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://the-darkest-hour.local/schemas/frontier-inbox-v1.json",
  "title": "TDH Frontier Scout proposal",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "proposal_version",
    "hypothesis_id",
    "status",
    "family_thesis",
    "causal_mechanism",
    "source_evidence",
    "required_data",
    "timeframes",
    "bounded_parameters",
    "baseline_thesis",
    "negative_control_thesis",
    "falsification",
    "safety"
  ],
  "properties": {
    "proposal_version": {"const": "tdh-frontier-inbox-v1"},
    "hypothesis_id": {"type": "string", "pattern": "^TDH-SCOUT-[0-9]{6}$"},
    "status": {"const": "UNTRUSTED_INBOX"},
    "family_thesis": {"type": "string", "minLength": 20, "maxLength": 800},
    "causal_mechanism": {"type": "string", "minLength": 20, "maxLength": 1200},
    "source_evidence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_id", "claim", "provenance"],
        "properties": {
          "source_id": {"type": "string", "maxLength": 160},
          "claim": {"type": "string", "maxLength": 600},
          "provenance": {"type": "string", "maxLength": 500}
        }
      }
    },
    "required_data": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {"type": "string", "maxLength": 80}
    },
    "timeframes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {"enum": ["1m", "5m", "15m", "30m", "1h", "4h", "1d"]}
    },
    "bounded_parameters": {"type": "object", "minProperties": 1, "maxProperties": 16},
    "baseline_thesis": {"type": "string", "minLength": 10, "maxLength": 600},
    "negative_control_thesis": {"type": "string", "minLength": 10, "maxLength": 600},
    "falsification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["failure_condition", "minimum_test", "expected_information_gain"],
      "properties": {
        "failure_condition": {"type": "string", "maxLength": 800},
        "minimum_test": {"type": "string", "maxLength": 800},
        "expected_information_gain": {"type": "string", "maxLength": 800}
      }
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "data_only",
        "contains_executable_code",
        "trading_actions",
        "exchange_api_access",
        "controller_registration_required"
      ],
      "properties": {
        "data_only": {"const": true},
        "contains_executable_code": {"const": false},
        "trading_actions": {"const": false},
        "exchange_api_access": {"const": false},
        "controller_registration_required": {"const": true}
      }
    }
  }
}
